# ---------- Aplicação ----------
APP_ENV=dev                      # dev | test | prod (prod exige API_KEY e desativa /docs)
API_KEY=                         # gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
MAX_LINES_PER_REQUEST=50000
MAX_LINE_LENGTH=4096

# ---------- Persistência ----------
DATABASE_URL=sqlite:///./data/analyzer.db
# DATABASE_URL=postgresql+psycopg://analyzer:analyzer@db:5432/analyzer

# ---------- Auditoria ----------
AUDIT_LOG_PATH=./data/audit.log

# ---------- Privacidade (LGPD) ----------
MASK_IPS=true
MASK_USERS=true
PSEUDONYM_KEY=troque-esta-chave   # segredo HMAC; trocar em produção (rotacionar invalida correlação histórica)

# ---------- Detecção ----------
WINDOW_MINUTES=10
FAILURE_THRESHOLD=3
SPRAY_USER_THRESHOLD=5
PRIVILEGED_ACCOUNTS=admin,root,administrator,sa,sysadmin,superuser
BUSINESS_HOURS_START=7
BUSINESS_HOURS_END=20
SUSPICIOUS_IPS=                  # CIDRs separados por vírgula, ex.: 203.0.113.0/24,198.51.100.7/32

# ---------- IA / LLM ----------
LLM_PROVIDER=none                # none | anthropic | openai 
LLM_API_KEY=
LLM_MODEL=                       
LLM_BASE_URL=                    # opcional
LLM_TIMEOUT_SECONDS=20
